# Copy to .env and fill in. .env is git-ignored.

# Argo API endpoint (must include /v1 if the OpenAI-compatible spec requires it)
ARGO_BASE_URL=https://apps.inside.anl.gov/argoapi/v1

# Argo username or token (per Argo internal docs)
ARGO_API_KEY=your-argo-token-or-username

# Model hosted on Argo
ARGO_MODEL=claudeopus47

# Optional: explicit Host header override sent with each request
ARGO_HOST_HEADER=apps.inside.anl.gov

# Optional: HTTP timeout (seconds) and retry count for Argo calls
ARGO_TIMEOUT_SECONDS=60
ARGO_MAX_RETRIES=2

# Optional: tomocupy backend selection. One of: docker (default), native.
# `native` runs `tomocupy ...` directly from PATH instead of `docker run ...`.
TOMOCUPY_BACKEND=native

# Optional: tomocupy Docker image and CLI binary (docker backend only)
#TOMOCUPY_IMAGE=tomocupy:latest
#TOMOCUPY_DOCKER_BIN=docker

# Optional: native tomocupy binary (native backend only). Use an absolute path
# when tomocupy isn't on the calling shell's PATH (e.g. inside a conda env).
#TOMOCUPY_BIN=your-tomocupy-path
